# 复制成 .env 再改。.env 不进 git。不写 .env 时，使用 bidradar/app/settings.py 里的默认值。

# API 进程和 Alembic 用的数据库。
BIDRADAR_DATABASE_URL=postgresql+psycopg://bidradar:bidradar@localhost:5432/bidradar

# pytest 用的数据库，只有测试读取。
BIDRADAR_TEST_DATABASE_URL=postgresql+psycopg://bidradar:bidradar@localhost:5432/bidradar_test
